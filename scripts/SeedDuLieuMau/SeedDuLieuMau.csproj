<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SeedDuLieuMau</RootNamespace>
  </PropertyGroup>

  <!--
    Chỉ ProjectReference, KHÔNG PackageReference nào: EF Core đến từ Infrastructure
    và IPasswordHasher<User> đến từ Application, cả hai chảy sang đây theo đường
    transitive. Nhờ vậy script không có dòng version nào để lệch với repo.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\MiniMart.Application\MiniMart.Application.csproj" />
    <ProjectReference Include="..\..\MiniMart.Infrastructure\MiniMart.Infrastructure.csproj" />
  </ItemGroup>

</Project>
