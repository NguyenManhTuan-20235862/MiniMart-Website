@model OrderView
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
}

@* Banner Đặt hàng thành công *@
<div class="es-success-hero">
    <div class="es-success-icon-wrap">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
    </div>
    <h1 class="es-success-title">Đặt hàng thành công!</h1>
    <p class="text-muted mb-3">Cảm ơn bạn đã mua sắm tại ElectroShop. Đơn hàng của bạn đã được tiếp nhận và xử lý.</p>
    <div class="es-order-badge">Mã đơn hàng của bạn là <strong>#@Model.Id</strong></div>
</div>

@*
    Mọi con số dưới đây đến từ OrderDetail đã SNAPSHOT, không join sang Products.
    Nhờ vậy mở lại trang này tháng sau vẫn ra đúng số tiền đã trả, kể cả khi shop
    đã đổi giá hoặc đổi tên sản phẩm.
*@
<div class="row g-4">
    @* Cột trái: Chi tiết sản phẩm *@
    <div class="col-lg-7">
        <div class="card es-checkout-card">
            <div class="card-header fw-bold es-checkout-header">
                <span class="es-checkout-header-icon">📦</span>
                Chi tiết sản phẩm đã mua
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th scope="col">Sản phẩm</th>
                                <th scope="col" class="text-end">Đơn giá</th>
                                <th scope="col" class="text-center" style="width: 80px;">Số lượng</th>
                                <th scope="col" class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@line.ProductName</td>
                                    <td class="text-end text-muted small">@line.UnitPrice.ToMoneyText() đ</td>
                                    <td class="text-center">@line.Quantity</td>
                                    <td class="text-end fw-bold text-danger">@line.LineTotal.ToMoneyText() đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng cộng</td>
                                <td class="text-end fw-bold text-danger fs-5">@Model.TotalAmount.ToMoneyText() đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* Cột phải: Thông tin giao hàng & Thời gian *@
    <div class="col-lg-5">
        @*
            Địa chỉ đọc từ SNAPSHOT trên Orders, không join sang User: đơn phải hiện đúng
            nơi đã giao tới, kể cả khi khách đổi hồ sơ tài khoản sau đó.
        *@
        <div class="card es-checkout-card">
            <div class="card-header fw-bold es-checkout-header">
                <span class="es-checkout-header-icon">📍</span>
                Giao tới
            </div>
            <div class="card-body p-4">
                <div class="fw-bold text-dark fs-6 mb-2">
                    @Model.Shipping.RecipientName &middot; @Model.Shipping.RecipientPhone
                </div>
                @*
                    white-space: pre-line để địa chỉ nhiều dòng (textarea) giữ được ngắt dòng.
                    @ của Razor đã escape sẵn nên xuống dòng bằng CSS chứ KHÔNG bằng cách thay
                    "\n" thành <br> rồi Html.Raw — đó là đường thẳng tới XSS.
                *@
                <div class="text-muted small" style="white-space: pre-line;">@Model.Shipping.Address</div>
            </div>
            <div class="card-footer bg-light p-3 text-muted small border-top">
                Đặt lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") (UTC) &middot;
                Tổng @Model.TotalQuantity món.
            </div>
        </div>

        <a class="es-btn-checkout btn btn-primary btn-lg w-100 text-white text-center text-decoration-none"
           asp-controller="Home" asp-action="Index">
            Tiếp tục mua sắm
        </a>
    </div>
</div>
