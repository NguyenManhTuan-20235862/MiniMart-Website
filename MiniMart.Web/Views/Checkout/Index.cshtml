@model CheckoutViewModel
@{
    ViewData["Title"] = "Xác nhận đặt hàng";
}

<div class="mb-4">
    <h1 class="es-section-title">Xác nhận đặt hàng</h1>
    <p class="es-section-subtitle">Vui lòng kiểm tra thông tin người nhận và lựa chọn phương thức thanh toán</p>
</div>

@*
    Một form duy nhất bọc CẢ hai cột. Nút "Xác nhận đặt hàng" nằm ở cột phải nhưng
    các ô nhập nằm ở cột trái, mà thẻ <form> không cần liền mạch về mặt hình ảnh —
    chỉ cần chứa hết các input. Tách làm hai form là nút bấm không gửi được địa chỉ.

    POST chứ không phải thẻ <a>: đây là thao tác GHI có hệ quả thật (trừ tồn kho,
    tạo đơn). GET thì chỉ cần nhúng một thẻ img trỏ tới URL này là đặt đơn hộ người
    khác — antiforgery token cũng không cứu được vì GET không đi qua nó.
*@
<form asp-action="Confirm" method="post">
    @*
        ModelOnly: chỉ hiện lỗi CẤP MODEL ở đây (VD "Sản phẩm X vừa hết hàng"). Lỗi
        của từng ô đã có <span asp-validation-for> ngay dưới ô đó; để "All" thì mỗi
        lỗi hiện hai lần và người dùng phải đọc hai lần mới biết là một.
    *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        @* Cột trái: Thông tin giao hàng *@
        <div class="col-lg-7">
            <div class="card es-checkout-card">
                <div class="card-header fw-bold es-checkout-header">
                    <span class="es-checkout-header-icon">📍</span>
                    Thông tin giao hàng
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="RecipientName" class="form-label font-semibold text-muted small uppercase"></label>
                        @*
                            asp-for ở form GHI dữ liệu (khác form LỌC ở trang chủ, nơi
                            name được đặt thủ công): ở đây tên trường không xuất hiện
                            trong URL nên "RecipientName" dài hơn cũng không sao, đổi
                            lại được value, id, và data-val-* của client validation.
                        *@
                        <input asp-for="RecipientName" class="form-control"
                               autocomplete="name" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="RecipientName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RecipientPhone" class="form-label font-semibold text-muted small uppercase"></label>
                        @*
                            type="tel" chứ KHÔNG type="number": số điện thoại không phải
                            một con số. type="number" làm mất số 0 đứng đầu ("0912..."
                            thành "912..."), chặn dấu + của mã quốc gia, và trên desktop
                            còn hiện nút tăng/giảm vô nghĩa.
                        *@
                        <input asp-for="RecipientPhone" class="form-control" type="tel"
                               autocomplete="tel" placeholder="0912345678" />
                        <span asp-validation-for="RecipientPhone" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="ShippingAddress" class="form-label font-semibold text-muted small uppercase"></label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="3"
                                  autocomplete="street-address"
                                  placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        @* Cột phải: Đơn hàng & Phương thức thanh toán *@
        <div class="col-lg-5">
            <div class="card es-checkout-card">
                <div class="card-header fw-bold es-checkout-header">
                    <span class="es-checkout-header-icon">🛍️</span>
                    Đơn hàng của bạn
                </div>
                <div class="card-body p-3">
                    @*
                        Dùng LẠI _CartTable với ChoPhepSua = false: cùng một khuôn bảng,
                        cùng cách in tiền, cùng logic badge còn/hết hàng — chỉ ẩn phần
                        sửa được. Tạo bảng riêng cho trang này là nhân đôi ba thứ đó.
                    *@
                    <partial name="_CartTable"
                             model="new CartTableViewModel(Model.Cart, ChoPhepSua: false)" />
                </div>
            </div>

            @if (Model.Cart.HasStockProblem)
            {
                @*
                    Cảnh báo, KHÔNG chặn mở trang: người dùng cần đọc được vấn đề nằm ở
                    đâu mới sửa được. Việc chặn thuộc về POST đặt hàng — đó là lúc dữ
                    liệu thật sự được ghi.
                *@
                <div class="alert alert-danger mt-3">
                    Có sản phẩm không còn đủ hàng. Hãy
                    <a asp-controller="Cart" asp-action="Index">quay lại giỏ hàng</a>
                    để điều chỉnh trước khi đặt.
                </div>
            }

            <div class="alert alert-warning mt-3 small">
                💡 <strong>Lưu ý về giá:</strong> số tiền ở trên là giá <em>hiện tại</em> của
                sản phẩm. Giá của đơn hàng được chốt lại vào đúng thời điểm bạn xác nhận.
            </div>

            @*
                HAI nút submit trong CÙNG một form, phân biệt bằng name+value.

                Cách này thay cho một cặp radio "chọn phương thức" rồi một nút submit:
                ít thao tác hơn một bước, và quan trọng hơn là không tồn tại trạng thái
                "đã chọn VNPay nhưng chưa bấm gửi" — thứ luôn sinh ra câu hỏi giao diện
                phải hiện gì trong lúc đó.

                Trình duyệt chỉ gửi name/value của ĐÚNG nút được bấm, nên PhuongThuc
                luôn khớp với hành động người dùng vừa làm. Thiếu tham số (JS tự submit,
                curl) thì binder cho ra Cod = 0 — mặc định an toàn.
            *@
            <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn es-btn-vnpay btn-lg"
                        name="PhuongThuc" value="@PhuongThucThanhToan.VnPay">
                    Thanh toán qua VNPay
                </button>

                <button type="submit" class="btn es-btn-cod btn-lg"
                        name="PhuongThuc" value="@PhuongThucThanhToan.Cod">
                    Đặt hàng, thanh toán khi nhận
                </button>
                @*
                    Thẻ <a> nằm TRONG form nhưng không phải nút submit, nên nó điều hướng
                    bình thường. Không dùng <button> cho nó: mọi <button> không ghi
                    type="button" bên trong form đều mặc định là submit.
                *@
                <a class="btn btn-outline-secondary btn-sm mt-1" asp-controller="Cart" asp-action="Index">
                    Quay lại giỏ hàng để sửa
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @*
        Client validation chỉ để phản hồi NHANH. Server vẫn kiểm lại toàn bộ trong
        ModelState.IsValid — bỏ qua JavaScript là chuyện một dòng curl làm được.
    *@
    <partial name="_ValidationScriptsPartial" />
}
