@using System.Security.Claims
@{
    ViewData["Title"] = "Thông tin tài khoản";
    var username = User.Identity?.Name ?? "Khách";
    var initial = !string.IsNullOrEmpty(username) ? username[0].ToString().ToUpper() : "U";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
}

@* Profile Header Card *@
<div class="es-profile-header-card">
    <div class="es-profile-avatar">@initial</div>
    <div class="flex-grow-1">
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="es-profile-title mb-0">@username</h1>
            @if (isAdmin)
            {
                <span class="badge bg-primary">Quản trị viên (Admin)</span>
            }
            else
            {
                <span class="badge bg-secondary">Khách hàng</span>
            }
        </div>
        <div class="es-profile-subtitle">
            ID Tài khoản: <strong>#@userId</strong> &middot; Đã xác thực qua Cookie
        </div>
    </div>
</div>

<div class="row g-4">
    @* Cột trái: Tóm tắt trạng thái *@
    <div class="col-lg-5">
        <div class="card es-checkout-card">
            <div class="card-header fw-bold es-checkout-header">
                <span class="es-checkout-header-icon">👤</span>
                Thông tin định danh
            </div>
            <div class="card-body p-4">
                <ul class="list-group list-group-flush mb-0">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted small">Tên người dùng</span>
                        <strong class="text-dark">@User.Identity?.Name</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted small">Trạng thái xác thực</span>
                        <span class="badge bg-success">@User.Identity?.IsAuthenticated</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted small">Quyền Admin</span>
                        <span class="badge @(isAdmin ? "bg-primary" : "bg-light text-dark border")">@isAdmin</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted small">User ID (NameIdentifier)</span>
                        <code>@userId</code>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-light p-3 small text-muted">
                💡 <em>Toàn bộ dữ liệu được giải mã từ cookie <code>MiniMart.Auth</code>, không hề có truy vấn database nào trong request này.</em>
            </div>
        </div>
    </div>

    @* Cột phải: Bảng Claims chi tiết *@
    <div class="col-lg-7">
        <div class="card es-checkout-card">
            <div class="card-header fw-bold es-checkout-header">
                <span class="es-checkout-header-icon">🔑</span>
                Chi tiết Claims trong Cookie
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th scope="col" style="min-width: 180px;">Claim Type</th>
                                <th scope="col">Giá trị</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in User.Claims)
                            {
                                <tr>
                                    <td><code class="small">@claim.Type</code></td>
                                    <td class="fw-semibold text-dark small">@claim.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
