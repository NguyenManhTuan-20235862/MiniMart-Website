@using MiniMart.Domain.ValueObjects
@model IReadOnlyList<ProductSuggestion>
@*
    Danh sách gợi ý cho ô tìm kiếm ở header.

    CỐ Ý không bọc trong thẻ bao nào: output dán thẳng được vào panel có sẵn, cùng
    tinh thần với _ProductCards. Panel (khung, viền, đổ bóng) do _Layout render sẵn,
    còn đây chỉ lo NỘI DUNG.

    Danh sách rỗng -> render ra chuỗi rỗng. JavaScript dựa vào đúng điều đó để biết
    khi nào nên ẩn panel, thay vì phải đọc một cờ nào khác.
*@
@if (Model.Count == 0)
{
    return;
}

@foreach (var goiY in Model)
{
    @*
        Mỗi dòng là một thẻ <a> thật, không phải <div> gắn onclick. Nhờ vậy nó bấm
        được bằng bàn phím, mở được ở tab mới bằng chuột giữa, và trình đọc màn hình
        đọc đúng là một liên kết. data-goi-y là hook để JS di chuyển bằng phím mũi tên.
    *@
    <a class="es-suggest-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none"
       asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@goiY.Id"
       data-goi-y>

        <div class="es-suggest-thumb flex-shrink-0">
            @if (string.IsNullOrEmpty(goiY.ImageUrl))
            {
                <span class="text-muted" style="font-size: 0.7rem;">—</span>
            }
            else
            {
                <img src="@goiY.ImageUrl" alt="" />
            }
        </div>

        <div class="flex-grow-1" style="min-width: 0;">
            @* text-truncate cần min-width:0 ở cha, nếu không flex item không co lại được. *@
            <div class="text-truncate fw-semibold text-dark" style="font-size: 0.85rem;">@goiY.Name</div>
            <div class="text-secondary" style="font-size: 0.72rem;">@goiY.CategoryName</div>
        </div>

        <div class="text-end flex-shrink-0">
            @*
                ToMoneyText() khoá vào InvariantCulture: cùng một số ra cùng một chuỗi
                bất kể locale của máy chạy server.
            *@
            <div class="fw-bold" style="font-size: 0.82rem; color: #DC2626;">
                @goiY.Price.ToMoneyText() đ
            </div>
            @*
                CHỈ trạng thái còn/hết, không bao giờ là con số tồn kho. Ở đây điều đó
                được bảo đảm bằng CẤU TRÚC: ProductSuggestion chỉ có bool ConHang,
                không có Stock để mà lỡ tay in ra.
            *@
            @if (!goiY.ConHang)
            {
                <div class="text-secondary" style="font-size: 0.68rem;">Hết hàng</div>
            }
        </div>
    </a>
}
