@model Product
@*
    Nhận thẳng entity Product, không qua DTO: Razor không serialize nên không
    có vòng lặp tham chiếu, và chỉ những trường được @ ở dưới mới xuất hiện
    trong HTML gửi đi.

    Đặt ở Views/Shared để trang Home và các trang sản phẩm sau này dùng chung
    một khuôn thẻ — đổi giao diện thẻ chỉ phải sửa một chỗ.
*@
<div class="col">
    <div class="card h-100 shadow-sm">

        @* Vùng ảnh *@
        <div class="es-product-img-wrap">
            @if (string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="es-product-img-placeholder">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="3"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21,15 16,10 5,21"/>
                    </svg>
                    <span style="font-size:0.75rem;">Chưa có ảnh</span>
                </div>
            }
            else
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }

            @* Badge danh mục nổi trên ảnh *@
            @if (Model.Category is not null)
            {
                <span class="es-product-cat-badge">@Model.Category.Name</span>
            }
        </div>

        @* Body *@
        <div class="es-product-body">
            <h6 class="es-product-name">@Model.Name</h6>

            @* ToMoneyText() khoá vào InvariantCulture: cùng một con số ra cùng
               một chuỗi bất kể locale của máy chạy server. *@
            <p class="es-product-price">
                @Model.Price.ToMoneyText()<small> đ</small>
            </p>

            @* Chỉ hiện TRẠNG THÁI còn/hết hàng, không hiện con số tồn kho —
               số lượng hàng tồn là thông tin kinh doanh. *@
            @if (Model.Stock == 0)
            {
                <span class="es-badge-out-stock">
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true">
                        <circle cx="4" cy="4" r="4"/>
                    </svg>
                    Hết hàng
                </span>
            }
            else
            {
                <span class="es-badge-in-stock">
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true">
                        <circle cx="4" cy="4" r="4"/>
                    </svg>
                    Còn hàng
                </span>

                @*
                    Vẫn là form POST thường và VẪN chạy khi tắt JavaScript: CartController
                    nhận cả request AJAX và form thường (Post-Redirect-Get). Form tag
                    helper tự chèn antiforgery token khi có asp-action.

                    data-cart-add chỉ là dấu để cart-dropdown.js chặn submit và gửi bằng
                    fetch. Không có JS thì thuộc tính này vô nghĩa và form submit như cũ —
                    đó là progressive enhancement, không phải hai đường code song song.
                *@
                <form asp-area="" asp-controller="Cart" asp-action="Add" method="post" data-cart-add>
                    <input type="hidden" name="ProductId" value="@Model.Id" />
                    <input type="hidden" name="Quantity" value="1" />
                    <button type="submit" class="es-btn-add-cart">
                        Thêm vào giỏ
                    </button>
                </form>
            }
        </div>
    </div>
</div>
