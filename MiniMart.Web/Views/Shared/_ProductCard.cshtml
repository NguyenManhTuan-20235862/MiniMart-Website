@model Product
@*
    Nhận thẳng entity Product, không qua DTO: Razor không serialize nên không
    có vòng lặp tham chiếu, và chỉ những trường được @ ở dưới mới xuất hiện
    trong HTML gửi đi.

    Đặt ở Views/Shared để trang Home và các trang sản phẩm sau này dùng chung
    một khuôn thẻ - đổi giao diện thẻ chỉ phải sửa một chỗ.
*@
<div class="col">
    <div class="card h-100 shadow-sm">
        @if (string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="bg-light d-flex align-items-center justify-content-center"
                 style="height: 180px;">
                <span class="text-muted small">Chưa có ảnh</span>
            </div>
        }
        else
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name"
                 style="height: 180px; object-fit: contain;" />
        }

        <div class="card-body d-flex flex-column">
            <h6 class="card-title">@Model.Name</h6>

            @if (Model.Category is not null)
            {
                <p class="card-text text-muted small mb-2">@Model.Category.Name</p>
            }

            @* ToMoneyText() khoá vào InvariantCulture: cùng một con số ra cùng
               một chuỗi bất kể locale của máy chạy server. *@
            <p class="card-text fw-bold text-danger mt-auto mb-1">
                @Model.Price.ToMoneyText() đ
            </p>

            @* Chỉ hiện TRẠNG THÁI còn/hết hàng, không hiện con số tồn kho -
               số lượng hàng tồn là thông tin kinh doanh. *@
            @if (Model.Stock == 0)
            {
                <span class="badge bg-secondary align-self-start">Hết hàng</span>
            }
            else
            {
                <span class="badge bg-success align-self-start">Còn hàng</span>
            }
        </div>
    </div>
</div>
