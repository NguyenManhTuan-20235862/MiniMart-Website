@model ProductFormViewModel
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<h2>Sửa sản phẩm</h2>

<div class="col-md-6">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* Đường dẫn ảnh cũ phải đi vòng qua form, nếu không POST sẽ không biết
           ảnh hiện tại là gì để dọn file cũ sau khi thay ảnh. *@
        <input type="hidden" asp-for="ExistingImageUrl" />

        @*
            Phiên bản bản ghi lúc form được MỞ, gửi lại để server phát hiện xung
            đột. Đây là mảnh ghép biến Optimistic Concurrency từ "bảo vệ vài
            millisecond trong Service" thành "bảo vệ suốt thời gian form mở".

            Render Base64 THỦ CÔNG chứ không dùng asp-for: InputTagHelper gọi
            ToString() trên byte[] và cho ra chuỗi "System.Byte[]", model binder
            phía sau không giải mã được - lỗi im lặng, form vẫn submit bình thường.
        *@
        <input type="hidden" name="RowVersion"
               value="@(Model.RowVersion is null ? null : Convert.ToBase64String(Model.RowVersion))" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">-- Chọn danh mục --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label"></label>
            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ExistingImageUrl" alt="Ảnh hiện tại" style="max-height: 120px;" class="img-thumbnail" />
                </div>
            }
            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
            <div class="form-text">Bỏ trống nếu muốn giữ ảnh hiện tại.</div>
        </div>

        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-link">Huỷ</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
