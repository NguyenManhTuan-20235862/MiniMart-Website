@model ProductFormViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" title="Quay lại">←</a>
        <h1 class="es-section-title mb-0">Thêm sản phẩm mới</h1>
    </div>
    <p class="es-section-subtitle mt-1 mb-0">Nhập đầy đủ thông tin để khởi tạo sản phẩm mới vào hệ thống</p>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="card es-checkout-card">
            <div class="card-header fw-bold es-checkout-header">
                <span class="es-checkout-header-icon">📦</span>
                Thông tin sản phẩm
            </div>

            <div class="card-body p-4">
                @* enctype="multipart/form-data" là BẮT BUỘC khi có input type="file".
                   Thiếu nó thì trình duyệt chỉ gửi TÊN file, IFormFile luôn null và
                   không có lỗi nào báo cho biết. *@
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label font-semibold text-muted small uppercase"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Laptop Dell XPS 15" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label font-semibold text-muted small uppercase"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label font-semibold text-muted small uppercase"></label>
                            <div class="input-group">
                                <input asp-for="Price" class="form-control text-end" placeholder="0" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label font-semibold text-muted small uppercase"></label>
                            <input asp-for="Stock" class="form-control text-end" placeholder="0" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageFile" class="form-label font-semibold text-muted small uppercase"></label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            <div class="form-text">Tối đa 2MB, định dạng jpg / png / webp.</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                            Lưu sản phẩm
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Huỷ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
