@model ProductBulkUpdateViewModel
@{
    ViewData["Title"] = "Sửa giá / tồn kho hàng loạt";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sửa giá / tồn kho hàng loạt</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Về danh sách sản phẩm</a>
</div>

@if (Model.KhongCoDong)
{
    <div class="alert alert-light border">Chưa có sản phẩm nào để sửa.</div>
}
else
{
    <form asp-action="BulkEdit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @*
            Trang hiện tại đi vòng qua form để sau khi lưu còn quay lại đúng chỗ cũ.
            Không có nó thì lưu xong luôn nhảy về trang 1.
        *@
        <input type="hidden" asp-for="Page" />

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col" style="width: 200px;">Giá (VNĐ)</th>
                        <th scope="col" style="width: 160px;">Tồn kho</th>
                    </tr>
                </thead>
                <tbody>
                    @*
                        ★ BẮT BUỘC dùng `for` với chỉ số, KHÔNG dùng `foreach`.

                        Với foreach thì asp-for="dong.Price" sinh ra name="Price" không
                        có chỉ số: mọi dòng trùng tên nhau và model binder chỉ nhận được
                        một giá trị duy nhất. Không lỗi build, không lỗi runtime - chỉ là
                        19/20 dòng biến mất.

                        Chỉ số phải LIÊN TỤC từ 0: binder đọc Items[0], Items[1]... và
                        DỪNG ở chỉ số đầu tiên thiếu. Vì vậy tuyệt đối không dùng
                        Items[@dong.Id] - id không bao giờ liên tục từ 0.

                        ★ HỆ QUẢ cho các dòng bị xung đột bên dưới: TUYỆT ĐỐI không đặt
                        `disabled` lên input của chúng, dù nghe rất hợp lý ("dòng này
                        đang hỏng, khoá lại"). Trình duyệt KHÔNG gửi input disabled, nên
                        dòng đó biến mất khỏi form, chỉ số đứt quãng, và binder âm thầm
                        bỏ TOÀN BỘ phần còn lại của bảng. Muốn khoá thì dùng `readonly`
                        - readonly vẫn được gửi.
                    *@
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var xungDot = Model.Items[i].XungDot;

                        @*
                            Dòng bị bỏ qua được tô ngay tại chỗ. Chỉ có một câu thông báo
                            ở đầu trang là bắt Admin đối chiếu bằng mắt giữa một đoạn văn
                            và 20 dòng bảng - việc mà máy làm được còn người thì làm sai.

                            table-danger cho sản phẩm đã bị XOÁ, table-warning cho sản
                            phẩm bị người khác SỬA: hai tình huống cần hai hành động khác
                            nhau (một cái tải lại trang, một cái bấm Lưu lần nữa).
                        *@
                        <tr class="@(xungDot is null ? "" : xungDot.DaBiXoa ? "table-danger" : "table-warning")">
                            <td>
                                @*
                                    Id BẮT BUỘC có mặt: thiếu nó thì binder cho ra Id = 0
                                    và dòng mất danh tính hoàn toàn.
                                *@
                                <input type="hidden" asp-for="Items[i].Id" />

                                @*
                                    ★ RowVersion render Base64 THỦ CÔNG.

                                    Đã ĐO chính xác điều kiện của cái bẫy, và nó tinh tế
                                    hơn quy ước cũ mô tả:

                                      <input type="hidden" asp-for="..."/>  -> Base64 ĐÚNG
                                      <input asp-for="..."/>                -> "System.Byte[]"

                                    Vì DefaultHtmlGenerator.GenerateHidden có nhánh riêng
                                    mã hoá byte[] sang Base64, còn đường input thường thì
                                    gọi ToString(). Tức chỉ cần ai đó bỏ type="hidden" đi
                                    là concurrency biến mất trong im lặng.

                                    Viết tay thì kết quả không phụ thuộc vào chi tiết đó.
                                    Chiều ngược lại (POST) binder tự giải mã Base64 ->
                                    byte[], nên chỉ chiều render mới phải làm tay.
                                *@
                                <input type="hidden" name="Items[@i].RowVersion"
                                       value="@(Model.Items[i].RowVersion is null ? string.Empty : Convert.ToBase64String(Model.Items[i].RowVersion!))" />

                                @* Name có [BindNever] nên chỉ hiện ra, không có input nào. *@
                                <span data-ten-san-pham>@Model.Items[i].Name</span>

                                @if (xungDot is not null)
                                {
                                    <div class="small fw-semibold mt-1" data-xung-dot="@Model.Items[i].Id">
                                        @if (xungDot.DaBiXoa)
                                        {
                                            <span>&#9888; Đã bị xoá khỏi hệ thống. Tải lại trang để bảng khớp với dữ liệu thật.</span>
                                        }
                                        else
                                        {
                                            <span>&#9888; Bị bỏ qua - người khác vừa sửa dòng này.</span>
                                        }
                                    </div>
                                }
                            </td>

                            <td>
                                @*
                                    type="number" + step: theo chuẩn HTML, input number
                                    luôn gửi giá trị ở dạng chuẩn hoá (dấu "." thập phân)
                                    bất kể locale trình duyệt. Với type="text", người dùng
                                    vi-VN gõ "1.000.000" thì model binding trả về 0 TRONG
                                    IM LẶNG - không lỗi nào, chỉ là giá về 0.
                                *@
                                <input asp-for="Items[i].Price" type="number"
                                       step="0.01" min="0.01" class="form-control form-control-sm" />
                                <span asp-validation-for="Items[i].Price" class="text-danger small"></span>

                                @*
                                    Giá trị của NGƯỜI KIA, ngay cạnh ô nhập của mình. Đây
                                    mới là thứ Admin cần để quyết định ghi đè hay không -
                                    "có xung đột" một mình không trả lời được câu hỏi nào.
                                *@
                                @if (xungDot is { DaBiXoa: false })
                                {
                                    <div class="small text-muted mt-1" data-gia-hien-tai="@Model.Items[i].Id">
                                        Hiện tại: @xungDot.PriceHienTai.ToMoneyText() đ
                                    </div>
                                }
                            </td>

                            <td>
                                <input asp-for="Items[i].Stock" type="number"
                                       step="1" min="0" class="form-control form-control-sm" />
                                <span asp-validation-for="Items[i].Stock" class="text-danger small"></span>

                                @if (xungDot is { DaBiXoa: false })
                                {
                                    <div class="small text-muted mt-1" data-ton-kho-hien-tai="@Model.Items[i].Id">
                                        Hiện tại: @xungDot.StockHienTai
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Trang @Model.Page / @Model.TongSoTrang &middot; @Model.TongSoSanPham sản phẩm
            </span>

            <button type="submit" class="btn btn-primary">Lưu tất cả</button>
        </div>
    </form>

    @*
        Phân trang nằm NGOÀI form: đây là các thẻ <a> điều hướng (GET), không phải dữ
        liệu gửi lên. Đặt trong form cũng chạy, nhưng để ngoài thì rõ ràng hơn rằng bấm
        sang trang khác là BỎ mọi thay đổi chưa lưu.
    *@
    <nav class="mt-3">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                <a class="page-link" asp-action="BulkEdit" asp-route-page="@(Model.Page - 1)">Trước</a>
            </li>
            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                <a class="page-link" asp-action="BulkEdit" asp-route-page="@(Model.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>

    <div class="alert alert-warning mt-3">
        Chuyển trang sẽ <strong>bỏ</strong> mọi thay đổi chưa lưu trên trang hiện tại.
        Cả bảng được lưu trong <strong>một</strong> transaction: nếu có một sản phẩm
        vừa bị người khác sửa thì <strong>không dòng nào</strong> được ghi.
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
