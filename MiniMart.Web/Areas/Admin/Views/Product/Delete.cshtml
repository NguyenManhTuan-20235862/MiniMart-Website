@model Product
@{
    ViewData["Title"] = "Xoá sản phẩm";
}

<h2>Xoá sản phẩm</h2>

<div class="alert alert-warning">
    Bạn có chắc muốn xoá sản phẩm <strong>@Model.Name</strong>
    (danh mục @Model.Category.Name, tồn kho @Model.Stock)?
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xoá</button>
    <a asp-action="Index" class="btn btn-link">Huỷ</a>
</form>
