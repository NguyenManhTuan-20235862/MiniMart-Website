@model Product
@{
    ViewData["Title"] = "Xoá sản phẩm";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" title="Quay lại">←</a>
        <h1 class="es-section-title mb-0">Xoá sản phẩm</h1>
    </div>
    <p class="es-section-subtitle mt-1 mb-0">Xác nhận thông tin trước khi thực hiện xoá sản phẩm khỏi hệ thống</p>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-danger border-opacity-50 shadow-sm mb-4">
            <div class="card-header bg-danger bg-opacity-10 text-danger fw-bold d-flex align-items-center gap-2 py-3">
                <span class="fs-5">⚠️</span>
                Xác nhận xoá sản phẩm
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning border-warning border-opacity-25 d-flex align-items-start gap-3 mb-4">
                    <div class="fs-4">📢</div>
                    <div>
                        Bạn có chắc muốn xoá sản phẩm <strong>@Model.Name</strong>
                        (danh mục <strong>@Model.Category.Name</strong>, tồn kho <strong>@Model.Stock</strong>)?
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-4 text-center">
                        <div class="d-inline-block p-2 bg-light rounded border">
                            <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height: 120px; object-fit: contain;" class="rounded border" />
                            <div class="text-muted small mt-1">@Model.Name</div>
                        </div>
                    </div>
                }

                <div class="bg-light p-3 rounded border mb-4">
                    <div class="row g-2 text-sm">
                        <div class="col-6">
                            <span class="text-muted">Mã sản phẩm:</span>
                            <strong class="text-dark">#@Model.Id</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Giá bán:</span>
                            <strong class="text-danger">@Model.Price.ToString("N0") đ</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Danh mục:</span>
                            <strong class="text-dark">@Model.Category.Name</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Tồn kho:</span>
                            <strong class="text-dark">@Model.Stock</strong>
                        </div>
                    </div>
                </div>

                <div class="text-danger small mb-4">
                    ⚡ <em>Hành động này không thể hoàn tác. Sản phẩm sẽ bị xoá khỏi cơ sở dữ liệu.</em>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-danger fw-semibold px-4 shadow-sm">
                        Xác nhận xoá
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Huỷ
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
