@model Category
@{
    ViewData["Title"] = "Xoá danh mục";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" title="Quay lại">←</a>
        <h1 class="es-section-title mb-0">Xoá danh mục</h1>
    </div>
    <p class="es-section-subtitle mt-1 mb-0">Xác nhận thông tin trước khi thực hiện xoá danh mục sản phẩm</p>
</div>

<div class="row">
    <div class="col-lg-6 col-xl-5">
        <div class="card border-danger border-opacity-50 shadow-sm mb-4">
            <div class="card-header bg-danger bg-opacity-10 text-danger fw-bold d-flex align-items-center gap-2 py-3">
                <span class="fs-5">⚠️</span>
                Xác nhận xoá danh mục
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning border-warning border-opacity-25 d-flex align-items-start gap-3 mb-4">
                    <div class="fs-4">📢</div>
                    <div>
                        Bạn có chắc muốn xoá danh mục <strong>@Model.Name</strong>?
                        Danh mục còn sản phẩm sẽ không xoá được.
                    </div>
                </div>

                <div class="bg-light p-3 rounded border mb-4">
                    <div class="row g-2 text-sm">
                        <div class="col-6">
                            <span class="text-muted">Mã danh mục:</span>
                            <strong class="text-dark">#@Model.Id</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Tên danh mục:</span>
                            <strong class="text-dark">@Model.Name</strong>
                        </div>
                    </div>
                </div>

                @* Xoá phải là POST: nếu là GET thì trình duyệt hoặc bot quét link có thể
                   kích hoạt lệnh xoá chỉ bằng cách truy cập URL. *@
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-danger fw-semibold px-4 shadow-sm">
                        Xác nhận xoá
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Huỷ
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
