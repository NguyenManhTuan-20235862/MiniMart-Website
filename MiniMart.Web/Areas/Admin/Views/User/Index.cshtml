@model UserListViewModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="es-section-title">Quản lý khách hàng</h1>
        <p class="es-section-subtitle mb-0">Danh sách tất cả các tài khoản người dùng trong hệ thống cửa hàng</p>
    </div>
</div>

@* Thanh tìm kiếm *@
<div class="card es-checkout-card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted">🔍</span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm kiếm theo tên đăng nhập..." />
                </div>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                    Tìm kiếm
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Xoá lọc
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Users.Count == 0)
{
    <div class="es-empty-state bg-white rounded-3 border p-5 text-center my-3">
        <div class="es-empty-state-icon">👥</div>
        <h4 class="fw-bold mb-2">Không tìm thấy tài khoản nào</h4>
        <p class="text-muted mb-0">
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <span>Không có tài khoản nào khớp với từ khoá <strong>"@Model.Search"</strong>.</span>
            }
            else
            {
                <span>Hệ thống chưa có tài khoản khách hàng nào.</span>
            }
        </p>
    </div>
}
else
{
    <div class="card es-checkout-card mb-4">
        <div class="card-header fw-bold es-checkout-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="es-checkout-header-icon">👥</span>
                Danh sách tài khoản
            </div>
            <span class="badge bg-primary rounded-pill">@Model.TotalUsers tài khoản</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small">
                            <th scope="col" class="ps-4" style="width: 100px;">Mã ID</th>
                            <th scope="col">Tên đăng nhập</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col" class="text-end pe-4" style="width: 160px;">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border">#@user.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="es-user-avatar" style="width: 32px; height: 32px; border-radius: 50%; background: rgba(79, 142, 247, 0.15); color: var(--es-blue-dark); font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
                                            @user.Username[..1].ToUpper()
                                        </div>
                                        <span class="fw-semibold text-dark">@user.Username</span>
                                    </div>
                                </td>
                                <td>
                                    @if (user.Role == UserRole.Admin)
                                    {
                                        <span class="badge bg-warning text-dark border border-warning px-2 py-1">
                                            👑 Admin (Quản trị viên)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                            👤 Customer (Khách hàng)
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                        Đang hoạt động
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Trang <strong>@Model.Page</strong> / <strong>@Model.TotalPages</strong> &middot; Tổng số <strong>@Model.TotalUsers</strong> tài khoản
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link px-3" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">← Trước</a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link px-3" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Sau →</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
