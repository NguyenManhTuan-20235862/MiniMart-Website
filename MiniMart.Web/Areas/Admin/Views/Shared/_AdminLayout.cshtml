@*
    Layout riêng cho khu vực quản trị. Tách khỏi _Layout của khách hàng vì hai
    bên phục vụ hai đối tượng khác nhau: menu khác, bố cục khác, và trang khách hàng
    có giỏ hàng, tìm kiếm - những thứ không thuộc về trang quản trị.
*@
@{
    // So khớp không phân biệt hoa/thường để đánh dấu mục menu đang mở.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string MenuDangMo(string ten) =>
        string.Equals(controller, ten, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMart Quản trị</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @* Navbar Admin cao cấp *@
    <nav class="navbar navbar-expand-lg navbar-dark es-navbar sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="es-brand-icon">⚡</span>
                <span class="fw-bold tracking-tight">ElectroShop</span>
                <span class="badge bg-warning text-dark font-semibold ms-1" style="font-size: 0.7rem; padding: 0.25rem 0.5rem;">QUẢN TRỊ</span>
            </a>

            <div class="d-flex align-items-center gap-3">
                <a class="btn btn-sm btn-outline-light d-flex align-items-center gap-1 rounded-pill px-3"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span>🌐</span> Về trang khách hàng
                </a>

                <span class="text-white-50 small d-none d-md-inline">
                    👤 <strong>@User.Identity?.Name</strong>
                </span>

                @* Logout là POST nên phải dùng form, không dùng thẻ <a>. *@
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">Đăng xuất</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-0">
        <div class="row g-0">
            @* Sidebar Admin *@
            <aside class="col-md-3 col-lg-2 es-admin-sidebar">
                <div class="es-admin-nav-label">Menu Quản trị</div>
                <div class="nav flex-column">
                    <a class="es-admin-nav-item list-group-item-action @MenuDangMo("Dashboard")"
                       asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <span>📊</span> Bảng điều khiển
                    </a>
                    <a class="es-admin-nav-item list-group-item-action @MenuDangMo("Category")"
                       asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <span>📁</span> Quản lý Danh mục
                    </a>
                    <a class="es-admin-nav-item list-group-item-action @MenuDangMo("Product")"
                       asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <span>📦</span> Quản lý Sản phẩm
                    </a>
                    <a class="es-admin-nav-item list-group-item-action @MenuDangMo("User")"
                       asp-area="Admin" asp-controller="User" asp-action="Index">
                        <span>👥</span> Quản lý Khách hàng
                    </a>
                </div>
            </aside>

            @* Main Content *@
            <main class="col-md-9 col-lg-10 p-4">
                <partial name="_StatusMessages" />

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
